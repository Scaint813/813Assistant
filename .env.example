BOT_TOKEN=put_new_bot_token_here
BOT_ID=8501494840
# Primary owner and administrator. Always remains in the allowlist.
ALLOWED_USER_ID=999166390
# Keep empty for owner-only mode. Later: 999166390,222222222,333333333
ALLOWED_USER_IDS=
MAX_ALLOWED_USERS=5

TIMEZONE=Europe/Moscow

OPENAI_API_KEY=put_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_SMART=gpt-5.6-terra
OPENAI_REASONING_FAST=low
OPENAI_REASONING_SMART=medium
OPENAI_MAX_OUTPUT_FAST=1800
OPENAI_MAX_OUTPUT_SMART=5000
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Deferred integration. Keep false until Miro returns to the product roadmap.
MIRO_SYNC_ENABLED=false
MIRO_ACCESS_TOKEN=put_miro_access_token_here
MIRO_BOARD_ID=put_miro_board_id_here
# AI-зона на доске: всё что создаёт бот — правее/ниже этой точки.
# Не перекрывает ручную зону пользователя.
# Рекомендуется выставить правее и ниже центра доски (X>=12000).
MIRO_AI_ZONE_START_X=12000
MIRO_AI_ZONE_START_Y=3000

# Optional Apple Health / Shortcuts bridge
HEALTH_BRIDGE_ENABLED=false
HEALTH_BRIDGE_HOST=127.0.0.1
HEALTH_BRIDGE_PORT=8781
HEALTH_BRIDGE_TOKEN=replace_with_a_long_random_secret
HEALTH_NUDGE_TIME=18:00
DEFAULT_STEP_GOAL=10000
HEALTH_MIN_STEP_GAP=1000

# Optional HSE timetable mirror. The iCal URL can contain a personal token:
# keep it only in .env and never commit it. Sending a .ics file to the bot works
# even while periodic sync is disabled.
HSE_ICAL_SYNC_ENABLED=false
HSE_ICAL_URL=
HSE_ICAL_SYNC_INTERVAL_MINUTES=60
# Used only when no exact saved route fact exists.
DEFAULT_TRANSFER_BUFFER_MINUTES=45

DATABASE_URL=sqlite+aiosqlite:///./assistant.db
RELIABILITY_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

CHECKIN_ENABLED=false
CHECKIN_MORNING_TIME=09:30
CHECKIN_DAY_TIME=14:30
CHECKIN_EVENING_TIME=21:30

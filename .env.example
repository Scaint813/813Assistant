TIMEZONE=Europe/Moscow

OPENAI_API_KEY=put_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_SMART=gpt-5.5
